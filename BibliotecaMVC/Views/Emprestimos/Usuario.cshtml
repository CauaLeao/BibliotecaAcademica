@model IEnumerable<BibliotecaMVC.Models.Emprestimo>
@{
    ViewData["Title"] = "Meus Empréstimos";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-bookmark-check"></i> Meus Empréstimos</h2>
    <a asp-controller="Livros" asp-action="Index" class="btn btn-outline-primary">Ver Catálogo</a>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Livro</th>
                        <th>Código Exemplar</th>
                        <th>Retirada</th>
                        <th>Previsão Devolução</th>
                        <th>Situação</th>
                        <th>Multa Acumulada</th>
                        <th class="text-end">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var emp in Model)
                    {
                        var atrasado = emp.EstaAtrasado(DateTime.Now);
                        var multa = emp.CalcularMulta(DateTime.Now);
                        <tr>
                            <td class="fw-semibold">@emp.Exemplar.Livro.Titulo</td>
                            <td><code>@emp.Exemplar.Codigo</code></td>
                            <td>@emp.DataRetirada.ToString("dd/MM/yyyy")</td>
                            <td class="@(atrasado && emp.Situacao == BibliotecaMVC.Enums.SituacaoEmprestimo.Ativo ? "text-danger fw-bold" : "")">
                                @emp.DataDevolucaoPrevista.ToString("dd/MM/yyyy")
                            </td>
                            <td>
                                @if (emp.Situacao == BibliotecaMVC.Enums.SituacaoEmprestimo.Ativo)
                                {
                                    if (atrasado)
                                    {
                                        <span class="badge bg-danger">Atrasado</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">No Prazo</span>
                                    }
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Encerrado</span>
                                }
                            </td>
                            <td>
                                @if (multa > 0)
                                {
                                    <span class="text-danger fw-bold">@multa.ToString("C")</span>
                                }
                                else
                                {
                                    <span class="text-muted">R$ 0,00</span>
                                }
                            </td>
                            <td class="text-end">
                                @if (emp.Situacao == BibliotecaMVC.Enums.SituacaoEmprestimo.Ativo && !emp.Renovado && !atrasado)
                                {
                                    <form asp-action="Renovar" method="post" class="d-inline">
                                        <input type="hidden" name="id" value="@emp.ID" />
                                        <button type="submit" class="btn btn-sm btn-outline-success">Renovar</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>