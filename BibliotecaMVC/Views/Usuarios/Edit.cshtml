@model BibliotecaMVC.ViewModels.UsuarioEditarViewModel
@using BibliotecaMVC.Enums

@{
    ViewData["Title"] = "Editar Usuário";
}

<h2 class="mb-3">Editar Usuário</h2>

<div class="row">
    <div class="col-md-7">
        <form asp-action="Edit" method="post" class="card card-body shadow-sm">
            <input type="hidden" asp-for="ID" />
            <input type="hidden" asp-for="CPF" />
            <input type="hidden" asp-for="TipoUsuario" />

            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label">CPF</label>
                    <input value="@Model.CPF" class="form-control" disabled />
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label">Tipo de conta</label>
                    <input value="@Model.TipoUsuario" class="form-control" disabled />
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="Nome" class="form-label"></label>
                <input asp-for="Nome" class="form-control" />
                <span asp-validation-for="Nome" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            @if (Model.TipoUsuario == TipoUsuario.Cliente)
            {
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Perfil" class="form-label"></label>
                        <select asp-for="Perfil" asp-items="Html.GetEnumSelectList<TipoCliente>()" class="form-select"></select>
                        <span asp-validation-for="Perfil" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="RegistroInstitucional" class="form-label"></label>
                        <input asp-for="RegistroInstitucional" class="form-control" />
                        <span asp-validation-for="RegistroInstitucional" class="text-danger small"></span>
                    </div>
                </div>
            }
            else if (Model.TipoUsuario == TipoUsuario.Bibliotecario)
            {
                <div class="mb-3">
                    <label asp-for="Matricula" class="form-label"></label>
                    <input asp-for="Matricula" class="form-control" />
                    <span asp-validation-for="Matricula" class="text-danger small"></span>
                </div>
            }

            <div class="mb-3">
                <label asp-for="NovaSenha" class="form-label"></label>
                <input asp-for="NovaSenha" class="form-control" placeholder="Deixe em branco para manter a senha atual" />
                <span asp-validation-for="NovaSenha" class="text-danger small"></span>
            </div>

            <div class="d-flex gap-2 mt-2">
                <button type="submit" class="btn btn-primary">Salvar alterações</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
