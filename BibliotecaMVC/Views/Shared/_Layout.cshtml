@using Microsoft.AspNetCore.Http
@{
    var usuarioId = Context.Session.GetInt32("UsuarioId");
    var usuarioNome = Context.Session.GetString("UsuarioNome");
    var tipoUsuario = Context.Session.GetString("TipoUsuario");
    var isGestor = tipoUsuario == "Bibliotecario" || tipoUsuario == "Administrador";
}
<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Bibliotech</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/BibliotecaMVC.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand fw-semibold" asp-controller="Home" asp-action="Index">Bibliotech</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Alternar navegação">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        @if (usuarioId.HasValue)
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Livros" asp-action="Index">Catálogo</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Emprestimos" asp-action="Meus">Meus Empréstimos</a>
                            </li>

                            @if (isGestor)
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-controller="Categorias" asp-action="Index">Categorias</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-controller="Usuarios" asp-action="Index">Usuários</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-controller="Emprestimos" asp-action="Index">Gerenciar Empréstimos</a>
                                </li>
                            }
                        }
                    </ul>

                    <ul class="navbar-nav align-items-sm-center">
                        @if (usuarioId.HasValue)
                        {
                            <li class="nav-item me-3">
                                <span class="navbar-text text-dark">
                                    Olá, <strong>@usuarioNome</strong>
                                    <span class="badge bg-secondary ms-1">@tipoUsuario</span>
                                </span>
                            </li>
                            <li class="nav-item">
                                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-outline-danger btn-sm">Sair</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="btn btn-primary btn-sm" asp-controller="Account" asp-action="Login">Entrar</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @if (TempData["Sucesso"] is string sucesso)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @sucesso
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar"></button>
                </div>
            }
            @if (TempData["Erro"] is string erro)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    @erro
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar"></button>
                </div>
            }

            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - Bibliotech
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>